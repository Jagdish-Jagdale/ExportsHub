# Gmail IMAP credentials
GMAIL_USER=printfhelloworld99@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Path to your Firebase Admin SDK service account JSON key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# How often to check for new emails (in milliseconds). Default: 60s
POLL_INTERVAL_MS=60000

# How many recent emails to fetch per poll (default: 50)
FETCH_LIMIT=50
